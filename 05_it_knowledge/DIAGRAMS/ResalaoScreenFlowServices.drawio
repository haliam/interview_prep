        <mxCell id="zJ3GhCaiROSgRFB7ZYUR-1" value="1&amp;nbsp;" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=60;fontFamily=Verdana;fontColor=#F18808;fontStyle=1;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
