        </mxCell>
        <mxCell id="7fziMJ6z8vp10Nm0jYFX-16" value="&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Búsqueda con éxito =&amp;gt; Aparece el nombre del usuario encontrado y al seleccionarlo se rellenan el resto de campos necesarios asociados al cliente&lt;/span&gt;.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=15;fontFamily=Verdana;fontColor=#FFFFFF;fontStyle=1;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
