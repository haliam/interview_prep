        </mxCell>
        <mxCell id="0E3HyHEtlrjMw71yJAp2-1" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;font style=&quot;&quot; color=&quot;#000000&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 20px; font-weight: normal;&quot;&gt;Servicio de búsqueda de cliente. Lanza una llamada a ISERIES con la función &lt;/span&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;NORRECCLI &lt;span style=&quot;font-weight: normal;&quot;&gt;y busca datos asociados al número de identificación.&lt;/span&gt;&lt;/span&gt;" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=15;fontFamily=Verdana;fontColor=#FFFFFF;fontStyle=1;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
          <mxGeometry x="-101" y="1722" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7fziMJ6z8vp10Nm0jYFX-14" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Dropdown despliega opciones en función del resultado de la búsqueda.&lt;/span&gt;&lt;/span&gt;" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=15;fontFamily=Verdana;fontColor=#FFFFFF;fontStyle=1;movable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
